{
  "name": "instamart-discovery-engine",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "scrape:stores": "tsx scripts/scrape/playstore.ts && tsx scripts/scrape/appstore.ts",
    "scrape:reddit": "tsx scripts/scrape/reddit_boost.ts && tsx scripts/scrape/reddit_from_cache.ts",
    "scrape:all": "npm run scrape:stores && npm run scrape:reddit",
    "pipeline": "tsx scripts/pipeline/run.ts",
    "pipeline:validate": "tsx scripts/pipeline/validate.ts",
    "deck": "python3 scripts/deck/generate_deck.py && python3 scripts/deck/export_pdf.py"
  },
  "dependencies": {
    "groq-sdk": "^0.29.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.1.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.5.2",
    "google-play-scraper": "^10.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
